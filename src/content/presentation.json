      "receiptTitle": "物流执行记录",
      "receiptNote": "订舱、实际出运、约定交付各有条件；插画中的船不代表货物已装船。",
      "phases": [
        {
          "label": "比较运输",
          "note": "把班期、运费、保险和合同责任放在同一张计划上。",
          "cue": "reading",
          "customerExpression": "neutral",
          "nodeIds": ["L06.plan", "L06.insurance"]
