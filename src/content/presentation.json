  "stages": [
    {
      "stage": 1,
      "title": "从样品桌出发",
      "subtitle": "选一件你愿意认真了解的产品，寻找能兑现承诺的供应商。",
      "scene": "samples",
      "navLabel": "选品与供应商"
    },
    {
      "stage": 2,
      "title": "收件箱里的机会",
      "subtitle": "每封询盘都需要证据。先读需求，再决定如何回应。",
      "scene": "inbox",
      "navLabel": "询盘与客户"
    },
    {
      "stage": 3,
      "title": "把每一笔成本算清",
      "subtitle": "让数字有出处，也让报价留出合理空间。",
      "scene": "quote",
      "navLabel": "报价工作台"
    },
    {
      "stage": 4,
      "title": "坐下来，谈一份好合同",
      "subtitle": "价格、付款与交付条件，需要放在一起考虑。",
      "scene": "meeting",
      "navLabel": "谈判与签约"
    },
    {
      "stage": 5,
      "title": "去仓库，看真实的货",
      "subtitle": "从 PI 到到账凭证，再到验货记录，一项一项核对。",
      "scene": "warehouse",
      "navLabel": "PI 与备货验货"
    },
    {
      "stage": 6,
      "title": "让订单准备出海",
      "subtitle": "比较船期、运费和保险；出运状态以实际记录为准。",
      "scene": "harbor",
      "navLabel": "物流与出运"
    },
    {
      "stage": 7,
      "title": "最后一程，核对与收汇",
      "subtitle": "单据一致，款项核实，退税有据，才算走完这一单。",
      "scene": "documents",
      "navLabel": "单据与收汇"
    }
  ],
