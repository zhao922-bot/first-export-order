{
  "name": "first-export-order",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:schema": "tsx scripts/export-json-schema.ts",
    "build": "pnpm content:validate && pnpm typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "balance:simulate": "tsx scripts/simulate-balance.ts",
    "playtest:aggregate": "tsx scripts/aggregate-playtest.ts",
    "playtest:package": "pnpm build && tsx scripts/package-local-playtest.ts",
    "test:local-package": "playwright test --config=playwright.local.config.ts",
    "package:exe": "pnpm build && tsx scripts/prepare-desktop.ts && electron-builder --config electron-builder.config.json --win portable --x64 --publish never",
    "package:apk": "pnpm build && cap sync android && tsx scripts/prepare-android.ts && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-android.ps1",
    "test:native": "playwright test --config=playwright.native.config.ts",
    "test:android": "playwright test --config=playwright.android.config.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "decimal.js": "^10.6.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/devtools-api": "^8.2.1",
    "@vue/tsconfig": "^0.9.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
