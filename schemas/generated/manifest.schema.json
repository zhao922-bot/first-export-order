{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "mode": {
      "type": "string",
      "enum": [
        "scaffold",
        "slice",
        "game"
      ]
    },
    "packs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!.*(?:\\.\\.|\\\\))[^:]+\\.json$"
      }
    },
    "onboarding": {
      "type": "string",
      "const": "onboarding.json"
    },
    "presentation": {
      "type": "string",
      "const": "presentation.json"
    }
  },
  "required": [
    "schemaVersion",
    "contentVersion",
    "mode",
    "packs"
  ],
  "additionalProperties": false
}
